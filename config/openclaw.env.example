# OpenClaw Telegram 환경변수 예시
# 실제 token, secret, password 값을 이 파일에 넣지 마세요.
# 실사용 값은 사용자 프로필, OS secret store, CI secret store 같은 안전한 위치에 둡니다.

OPENCLAW_TELEGRAM_ENABLED=true
OPENCLAW_TELEGRAM_BOT_TOKEN=
OPENCLAW_TELEGRAM_DM_POLICY=pairing
OPENCLAW_TELEGRAM_ALLOWLIST=
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=0
OPENCLAW_LOG_LEVEL=info
